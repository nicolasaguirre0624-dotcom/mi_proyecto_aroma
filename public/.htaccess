RewriteEngine On
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]
RewriteRule ^images/(.*)$ assets/images/$1 [L]
RewriteRule ^Practica_JSON/?(.*)$ practicas/json/$1 [NC,L]
RewriteRule ^ejercicios/?(.*)$ practicas/ejercicios/$1 [NC,L]
RewriteRule ^(productos|clientes|proveedores|ciudades|categorias|compras)(/(crear|editar|actualizar|eliminar))?/?$ index.php [QSA,L]
RewriteRule ^api(/.*)?$ index.php [QSA,L]
RewriteRule ^json/?$ index.php [QSA,L]
RewriteRule ^(login|logout)/?$ index.php [QSA,L]
